<?xml version="1.0"?>
<!-- Same floor, plus a 1.2 m x 1.2 m patch on the top-right corner of the route, exactly where the
     robot has to turn. Friction 0.02 is roughly rubber on ice. At 0.08 (wet tiles) nothing
     happened: at 0.3 m/s the turn barely needs any grip. -->
<sdf version="1.8">
  <world name="fusion_world">
    <physics name="1ms" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"/>
    <light type="directional" name="sun"><cast_shadows>true</cast_shadows><pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse><direction>-0.5 0.1 -0.9</direction></light>
    <model name="ground_plane"><static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry></collision>
        <visual name="v"><geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
      </link></model>
    <model name="slippery_patch"><static>true</static>
      <pose>1.25 2.75 0.0005 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.2 1.2 0.001</size></box></geometry>
          <surface><friction><ode><mu>0.02</mu><mu2>0.02</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><box><size>1.2 1.2 0.001</size></box></geometry>
          <material><ambient>0.4 0.7 0.95 1</ambient><diffuse>0.4 0.7 0.95 1</diffuse></material></visual>
      </link></model>
  </world>
</sdf>
